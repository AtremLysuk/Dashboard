generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ========== USER (Админ/Менеджер) ==========
model User {
  id           String  @id @default(cuid())
  email        String  @unique
  name         String?
  passwordHash String?
  role         Role    @default(ADMIN)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

enum Role {
  ADMIN
  MANAGER
}

// ========== CLIENT (Клиент без регистрации) ==========
model Client {
  id    String @id @default(cuid())
  token String @unique // уникальный токен (сохраняем в localStorage/cookies)

  // Контактные данные (сохраняем при первом заказе)
  name  String?
  phone String?
  email String?

  // Связи
  cart   Cart? // корзина клиента (одна на клиента)
  orders Order[] // история заказов этого клиента

  // Для аналитики/поиска
  lastOrderAt DateTime? // дата последнего заказа
  totalOrders Int       @default(0) // количество заказов
  totalSpent  Decimal   @default(0) // общая сумма заказов

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("clients")
}

// ========== CATEGORY ==========
model Category {
  id    String @id @default(cuid())
  name  String
  slug  String @unique
  order Int    @default(0) // для сортировки в меню

  products Product[]

  createdAt DateTime @default(now())

  @@map("categories")
}

// ========== PRODUCT ==========
model Product {
  id          String  @id @default(cuid())
  title       String
  slug        String  @unique
  description String?
  imageUrl    String
  isActive    Boolean @default(true)
  isFeatured  Boolean @default(false)

  // Цены
  basePrice Decimal // базовая цена
  salePrice Decimal? // цена со скидкой

  categoryId  String
  category    Category            @relation(fields: [categoryId], references: [id])
  variants    ProductVariant[]
  ingredients ProductIngredient[]
  cartItems   CartItem[] // исправлено: было CartItem CartItem[]
  orderItems  OrderItem[] // исправлено: было OrderItem OrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("products")
}

// ========== PRODUCT VARIANT ==========
model ProductVariant {
  id        String  @id @default(cuid())
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  size  String // "30 см", "40 см", "50 см"
  price Decimal // дополнительная цена за размер

  cartItems  CartItem[] // исправлено: было CartItem CartItem[]
  orderItems OrderItem[] // исправлено: было OrderItem OrderItem[]

  @@map("product_variants")
}

// ========== INGREDIENT ==========
model Ingredient {
  id       String  @id @default(cuid())
  name     String
  slug     String  @unique
  price    Decimal // цена добавления
  isActive Boolean @default(true)

  products ProductIngredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("ingredients")
}

// ========== PRODUCT-INGREDIENT ==========
model ProductIngredient {
  id String @id @default(cuid())

  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  ingredientId String
  ingredient   Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)

  isDefault   Boolean @default(true) // включен по умолчанию
  isRemovable Boolean @default(false) // можно убрать
  isExtra     Boolean @default(false) // дополнительный (за доплату)

  @@unique([productId, ingredientId])
  @@map("product_ingredients")
}

// ========== CART ==========
model Cart {
  id String @id @default(cuid())

  // Обязательная привязка к клиенту
  clientId String @unique // один клиент = одна корзина
  client   Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  items CartItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("carts")
}

model CartItem {
  id     String @id @default(cuid())
  cartId String
  cart   Cart   @relation(fields: [cartId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  quantity Int     @default(1)
  price    Decimal // цена на момент добавления

  // Дополнительные ингредиенты
  addedIngredients   Json? // [{id: "", name: "", price: 0}, ...]
  removedIngredients Json? // [ingredientId, ...]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cart_items")
}

// ========== ORDER ==========
model Order {
  id                String        @id @default(cuid())
  orderNumber       String        @unique
  // Клиент (если известен)
  clientId          String?
  client            Client?       @relation(fields: [clientId], references: [id])
  // Контактные данные
  customerName      String
  customerPhone     String
  customerEmail     String?
  // Адрес доставки
  deliveryAddress   String
  deliveryNotes     String?
  // Статус
  status            OrderStatus   @default(NEW)
  // Цены
  subtotal          Decimal
  deliveryFee       Decimal       @default(0)
  discount          Decimal       @default(0)
  tax               Decimal       @default(0)
  total             Decimal
  // Оплата
  paymentStatus     PaymentStatus @default(PENDING)
  // Время
  estimatedDelivery DateTime?
  deliveredAt       DateTime?
  // Элементы заказа
  items             OrderItem[]
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  // Индексы
  @@index([clientId])
  @@index([status])
  @@index([createdAt])
  @@index([customerPhone])
  @@index([orderNumber])
  @@map("orders")
}

model OrderItem {
  id      String @id @default(cuid())
  orderId String
  order   Order  @relation(fields: [orderId], references: [id], onDelete: Cascade)

  productId String
  product   Product @relation(fields: [productId], references: [id])

  variantId String?
  variant   ProductVariant? @relation(fields: [variantId], references: [id])

  title       String
  description String?
  imageUrl    String?
  price       Decimal
  quantity    Int     @default(1)

  addedIngredients   Json?
  removedIngredients Json?

  @@map("order_items")
}

enum OrderStatus {
  NEW
  PENDING
  IN_PROGRESS
  COMPLETED
  REJECTED
  CANCELLED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}
